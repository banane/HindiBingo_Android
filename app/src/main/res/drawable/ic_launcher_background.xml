<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon (Content/appicons/hi/AppIcon2.png, the same as iOS), inset to the 72dp that every
     launcher shape shows, so "BINGO" isn't cropped. The sky colour fills the edges. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CDCFD7" />
        </shape>
    </item>
    <item
        android:bottom="18dp"
        android:drawable="@drawable/ic_launcher_photo"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp" />
</layer-list>
